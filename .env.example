# ═══════════════════════════════════════════════════════════════════════
#  OCTUPUS-VOC — environment configuration
#
#  1. Copy this file:        cp .env.example .env.local
#  2. Fill in the REQUIRED section below
#  3. Verify your setup:     bun run doctor
#
#  NEVER commit .env.local — it is gitignored and must stay that way.
# ═══════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────
#  REQUIRED — the app will not work without these
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Free tier: https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign sessions. Must be 32+ characters.
# Generate one:  bun run doctor:secret     (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public base URL of this deployment.
#   local dev  -> http://localhost:3000
#   production -> https://your-domain.com
# On Vercel this is auto-detected if omitted, but setting it explicitly is safer.
BETTER_AUTH_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────
#  REQUIRED FOR SIGN-UP — without this, no one can create an account
#
#  Registration sends a 6-digit verification code by email, and no session
#  is issued until that code is entered. With no email provider configured
#  the code is never sent and every new account is stuck at verification.
#
#  Pick ONE provider:
#    gmail  — free, ~500/day, works immediately, no domain needed
#    resend — higher volume, requires a verified domain
# ─────────────────────────────────────────────────────────────────────

EMAIL_PROVIDER=gmail

# If EMAIL_PROVIDER=gmail — use a Google *App Password*, not your login password.
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# If EMAIL_PROVIDER=resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM=OCTUPUS <onboarding@resend.dev>


# ═══════════════════════════════════════════════════════════════════════
#  EVERYTHING BELOW IS OPTIONAL
#  The app runs without these; each one enables an extra feature.
# ═══════════════════════════════════════════════════════════════════════


# ── Scheduled CVE sync ────────────────────────────────────────────────
# Shared secret protecting /api/cron/sync. The endpoint refuses ALL callers
# when this is unset (fail-closed by design).
# To enable automatic syncing, set the same value here AND in your repo:
#   Settings -> Secrets and variables -> Actions -> CRON_SECRET
# Also add APP_URL there (your deployment URL) so the workflow targets you.
CRON_SECRET=


# ── Data source rate limits ───────────────────────────────────────────
# Without a key NVD throttles to 5 req/30s; with one, 50 req/30s.
# Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Raises the GitHub advisory source from 60 to 5,000 req/hour.
# Any classic token with NO scopes works: https://github.com/settings/tokens
GITHUB_TOKEN=


# ── OAuth sign-in (optional alternative to email/password) ────────────
# Each provider activates only when BOTH of its values are present.
# Callback URL to register: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL to register: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosted Better Auth dashboard (@better-auth/infra) — purely optional.
BETTER_AUTH_API_KEY=


# ── AI CVE analysis ───────────────────────────────────────────────────
# Enables the per-CVE AI analysis panel. https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free


# ── Telegram alerts ───────────────────────────────────────────────────
# Pushes Critical/High/KEV CVEs to a Telegram chat. Both values required.
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Exposure providers (EASM — internet-exposure signal) ──────────────
# Powers the /exposure page and the exposure panels in CVE/0-day details.
# All optional and independent: each configured provider is queried, the
# rest are skipped. Account setup guide: docs/exposure-providers-setup.md
#
# Providers serve DIFFERENT roles (see README "Exposure Intelligence"):
#   discovery  — free-text search finds candidate hosts:  LeakIX, FOFA, ZoomEye
#   enrichment — deep per-host detail:                    Censys, Netlas
#   threat     — IP reputation / scanning activity:       GreyNoise
#
# Best free tiers — start with these two:
GREYNOISE_API_KEY=
LEAKIX_API_KEY=
# Also supported:
NETLAS_API_KEY=
CENSYS_API_TOKEN=
ZOOMEYE_API_KEY=
# FOFA requires BOTH values — a key alone silently stays disabled.
FOFA_EMAIL=
FOFA_API_KEY=
# Censys SEARCH additionally needs a paid plan + organization id. Without it,
# search reports a plan limitation while host-lookup enrichment still works.
CENSYS_ORG_ID=


# ── Tests ─────────────────────────────────────────────────────────────
# A SEPARATE database for tests — never point this at production.
# When unset, database-backed test suites are skipped (the rest still run).
TEST_DATABASE_URL=

# ── BYOK vault ───────────────────────────────────────────────────────────────
# Seals user-supplied provider API keys with AES-256-GCM before they are stored.
# The key lives here and NEVER in the database, so a database dump alone is
# inert. Generate with:  openssl rand -base64 32
# Rotating it makes every stored user credential undecryptable; affected users
# are asked to re-enter their keys rather than being blocked.
CREDENTIAL_ENCRYPTION_KEY=

# Dedicated database for the test suites. They INSERT/UPDATE/DELETE real rows,
# so without this the DB-backed suites SKIP rather than fall back to
# DATABASE_URL — which on a dev machine is production. Use a Neon branch.
TEST_DATABASE_URL=
