# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
# Any log written into the working tree. The specific npm/yarn/pnpm patterns
# below did not cover ad-hoc ones — `backfill.log` and `backfill.err.log` sat
# untracked-but-visible in the project root, which is how a log with a
# connection string in it ends up in a screen share.
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files — never commit real secrets
.env*
# ...but DO ship the annotated template, or a fresh clone has no config guide.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
